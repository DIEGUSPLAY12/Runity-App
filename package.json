{
  "name": "runity-app",
  "version": "1.0.0",
  "description": "Runity Monorepo - Frontend (React Native) + Backend (FastAPI)",
  "scripts": {
    "start": "concurrently \"pnpm run start:api\" \"pnpm run start:mobile\"",
    "start:api": "cd backend && ./venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "start:mobile": "cd mobile && npx expo start",
    "install:all": "pnpm run install:api && pnpm run install:mobile",
    "install:api": "cd backend && ./venv/bin/pip install -r requirements.txt",
    "install:mobile": "cd mobile && pnpm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
